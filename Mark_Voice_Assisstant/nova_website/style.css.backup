/* --- MARK AI RETRO CARTOON TV AESTHETIC --- */

:root {
    /* Retro TV Palette */
    --tv-orange: #d36604;
    --tv-gold: #e69635;
    --tv-orange-light: #f27405;
    --tv-orange-bright: #f69e50;
    --tv-brown-dark: #1d0e01;
    --tv-brown-light: #7f5934;
    --tv-brown-medium: #513721;
    --tv-gray-dark: #171717;
    --tv-gray-light: #4d4d4d;
    --tv-metallic: #979797;
    --tv-cream: #fafafa;
    
    /* Status Colors */
    --success: #00ff9d;
    --warning: #ffcc00;
    --error: #ff3366;

    /* Effects */
    --shadow-dark: 0px 8px 0px #513721;
    --shadow-light: 3px 3px 0px #e69635;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Montserrat', 'Rajdhani', sans-serif;
    background-color: #2a2a2a;
    background-image: 
        repeating-linear-gradient(
            0deg,
            rgba(0,0,0,.15),
            rgba(0,0,0,.15) 1px,
            transparent 1px,
            transparent 2px
        );
    color: #333;
    overflow-x: hidden;
    min-height: 100vh;
    font-weight: 500;
    line-height: 1.5;
}

/* Typography Overrides */
h1, h2, h3, .brand-text {
    font-family: 'Orbitron', 'Montserrat', sans-serif;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #000;
}

/* --- BACKGROUND FX --- */
.holographic-grid {
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background: linear-gradient(90deg, #1a1a1a 0%, #2a2a2a 50%, #1a1a1a 100%);
    pointer-events: none;
    z-index: -2;
    opacity: 0.8;
}

.scanlines {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: repeating-linear-gradient(
        to bottom, 
        transparent 0px, 
        transparent 2px, 
        rgba(0, 0, 0, 0.15) 2px, 
        rgba(0, 0, 0, 0.15) 4px
    );
    z-index: 1000;
    pointer-events: none;
    opacity: 0.5;
}

.vignette {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(circle, transparent 60%, rgba(0,0,0,0.4) 100%);
    z-index: -1;
    pointer-events: none;
}

.particle-background {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: -1;
    overflow: hidden;
}

.particle {
    position: absolute;
    background: var(--tv-gold);
    border-radius: 50%;
    box-shadow: 0 0 3px rgba(230, 150, 53, 0.4);
    animation: floatParticle linear infinite;
    opacity: 0.3;
}

@keyframes floatParticle {
    0% { transform: translateY(0) scale(1); opacity: 0; }
    50% { opacity: 0.4; }
    100% { transform: translateY(-100vh) scale(0); opacity: 0; }
}

/* --- NAVBAR --- */
.navbar {
    position: fixed;
    top: 0; left: 0; width: 100%;
    height: 70px;
    background: var(--tv-orange);
    border-bottom: 3px solid var(--tv-brown-dark);
    z-index: 900;
    transition: all 0.3s ease;
    box-shadow: var(--shadow-light);
}

.navbar-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.navbar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
}

.brand-text {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--tv-brown-dark);
    text-shadow: 2px 2px 0px rgba(0,0,0,0.2);
}

.navbar-menu {
    display: flex;
    gap: 1rem;
}

.navbar-item {
    color: var(--tv-brown-dark);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 2px solid var(--tv-brown-dark);
    border-radius: 5px;
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--tv-gold);
}

.navbar-item:hover, .navbar-item.active {
    color: #fff;
    background: var(--tv-brown-dark);
    transform: translateY(-3px);
    box-shadow: var(--shadow-dark);
}

.navbar-toggle {
    display: none;
    flex-direction: column;
    cursor: pointer;
    gap: 5px;
}

.navbar-toggle span {
    width: 25px; height: 3px;
    background: var(--tv-brown-dark);
    transition: 0.3s;
    border-radius: 2px;
}

/* --- COMMON SCREEN STYLES --- */
.screen {
    display: none;
    min-height: 100vh;
    padding-top: 80px;
    padding-bottom: 50px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeInScreen 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    background: linear-gradient(135deg, #2a2a2a 0%, #3a3a3a 100%);
}

.screen.active {
    display: flex;
    opacity: 1;
}

@keyframes fadeInScreen {
    from { opacity: 0; transform: translateY(20px); filter: blur(5px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
}

.container-3d {
    width: 100%;
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 20px;
}

.screen-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    text-align: center;
    color: var(--tv-brown-dark);
    text-shadow: 3px 3px 0px rgba(0,0,0,0.3);
    position: relative;
}

.screen-subtitle {
    color: var(--tv-brown-medium);
    margin-bottom: 3rem;
    font-size: 1.2rem;
    letter-spacing: 1px;
}

/* --- WELCOME SCREEN --- */
.holo-ring-container {
    position: relative;
    width: 300px;
    height: 300px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 2rem;
}

.holo-ring-outer {
    position: absolute;
    width: 100%; height: 100%;
    border: 2px solid transparent;
    border-top: 2px solid var(--neon-cyan);
    border-bottom: 2px solid var(--neon-violet);
    border-radius: 50%;
    animation: spinRight 8s linear infinite;
    box-shadow: 0 0 30px rgba(0, 243, 255, 0.2);
}

.holo-ring-inner {
    position: absolute;
    width: 70%; height: 70%;
    border: 2px solid transparent;
    border-left: 2px solid var(--neon-violet);
    border-right: 2px solid var(--neon-cyan);
    border-radius: 50%;
    animation: spinLeft 6s linear infinite;
}

.logo {
    font-size: 3.5rem;
    font-weight: 900;
    z-index: 10;
    background: linear-gradient(180deg, #fff, var(--neon-cyan));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: pulseGlow 3s infinite;
}

@keyframes spinRight { 100% { transform: rotate(360deg); } }
@keyframes spinLeft { 100% { transform: rotate(-360deg); } }
@keyframes pulseGlow {
    0%, 100% { filter: drop-shadow(0 0 10px rgba(0, 243, 255, 0.4)); }
    50% { filter: drop-shadow(0 0 25px rgba(0, 243, 255, 0.8)); }
}

.welcome-text {
    font-family: 'Courier New', monospace;
    color: var(--neon-cyan);
    margin-bottom: 3rem;
}

/* --- SYSTEM BRIEF (ABOUT SECTION) --- */
.system-brief {
    position: relative;
    max-width: 600px;
    background: rgba(10, 20, 40, 0.5);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(0, 243, 255, 0.3);
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 3rem;
    overflow: hidden;
    animation: briefGlitchIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 0 30px rgba(0, 243, 255, 0.1);
}

.system-brief::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(0, 243, 255, 0.05) 0%, transparent 70%);
    animation: briefGlowPulse 6s ease-in-out infinite;
}

.brief-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
}

.brief-icon {
    font-size: 1.5rem;
    color: var(--neon-cyan);
    filter: drop-shadow(0 0 8px var(--neon-cyan));
}

.brief-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.1rem;
    color: var(--neon-cyan);
    letter-spacing: 2px;
    text-shadow: 0 0 15px rgba(0, 243, 255, 0.3);
    margin: 0;
}

.brief-content {
    position: relative;
    z-index: 1;
}

.brief-text {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    font-family: 'Rajdhani', sans-serif;
}

.brief-text .highlight-cyan {
    color: var(--neon-cyan);
    font-weight: 600;
    text-shadow: 0 0 8px rgba(0, 243, 255, 0.4);
}

.brief-text .highlight-violet {
    color: var(--neon-violet);
    font-weight: 600;
    text-shadow: 0 0 8px rgba(188, 19, 254, 0.4);
}

.brief-features {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-start;
}

.feature-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 243, 255, 0.1);
    border: 1px solid rgba(0, 243, 255, 0.4);
    color: var(--neon-cyan);
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
}

.feature-tag:hover {
    background: rgba(0, 243, 255, 0.2);
    box-shadow: 0 0 15px rgba(0, 243, 255, 0.3);
    transform: translateY(-2px);
}

.feature-tag i {
    font-size: 0.7rem;
}

.brief-glow {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--neon-cyan), transparent);
    filter: blur(1px);
}

@keyframes briefGlitchIn {
    0% {
        opacity: 0;
        transform: translateY(-15px) skewX(-5deg);
        filter: blur(10px);
    }
    50% {
        transform: translateY(-8px) skewX(2deg);
    }
    100% {
        opacity: 1;
        transform: translateY(0) skewX(0deg);
        filter: blur(0);
    }
}

@keyframes briefGlowPulse {
    0%, 100% {
        transform: translate(0, 0) scale(1);
        opacity: 0.3;
    }
    50% {
        transform: translate(-10px, -10px) scale(1.1);
        opacity: 0.6;
    }
}

/* Responsive */
@media (max-width: 768px) {
    .system-brief {
        padding: 1.5rem;
        margin-bottom: 2rem;
    }
    
    .brief-title {
        font-size: 0.95rem;
    }
    
    .brief-text {
        font-size: 0.85rem;
        line-height: 1.6;
    }
    
    .brief-features {
        gap: 8px;
    }
    
    .feature-tag {
        font-size: 0.7rem;
        padding: 5px 10px;
    }
}

/* --- HOLO BUTTONS --- */
.holo-btn {
    position: relative;
    background: transparent;
    border: 1px solid var(--neon-cyan);
    color: var(--neon-cyan);
    padding: 1rem 2.5rem;
    font-family: 'Orbitron', sans-serif;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    overflow: hidden;
    transition: 0.4s;
    clip-path: polygon(10% 0, 100% 0, 100% 80%, 90% 100%, 0 100%, 0 20%);
}

.holo-btn:hover {
    background: rgba(0, 243, 255, 0.1);
    box-shadow: 0 0 30px rgba(0, 243, 255, 0.4);
    text-shadow: 0 0 8px var(--neon-cyan);
    transform: translateY(-2px);
}

.holo-btn.secondary {
    border-color: var(--neon-violet);
    color: var(--neon-violet);
}

.holo-btn.secondary:hover {
    background: rgba(188, 19, 254, 0.1);
    box-shadow: 0 0 30px rgba(188, 19, 254, 0.4);
    text-shadow: 0 0 8px var(--neon-violet);
}

.large-btn {
    font-size: 1.4rem;
    padding: 1.5rem 4rem;
    font-weight: 700;
}

/* --- 3D CARDS --- */
.version-cards, .variant-cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    width: 100%;
}

.tilt-card {
    position: relative;
    background: rgba(10, 15, 30, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2.5rem;
    width: 350px;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
    cursor: pointer;
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
    overflow: hidden;
}

.tilt-card:hover {
    transform: translateY(-10px) scale(1.02);
    border-color: var(--neon-cyan);
    box-shadow: 0 0 30px rgba(0, 243, 255, 0.2);
}

.tilt-card.selected {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 50px rgba(0, 243, 255, 0.3), inset 0 0 20px rgba(0, 243, 255, 0.1);
    background: rgba(0, 243, 255, 0.05);
}

/* Specific Card Styles */
.card-icon-container {
    font-size: 4rem;
    color: var(--neon-cyan);
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 0 10px var(--neon-cyan));
}

.card-title, .variant-title {
    color: #fff;
    margin-bottom: 1rem;
    font-size: 1.4rem;
}

.card-description {
    color: #aaa;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
}

/* Status Indicators */
.key-status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(0,0,0,0.3);
    padding: 8px;
    border-radius: 4px;
    border: 1px solid rgba(255,255,255,0.1);
    margin-top: 1rem;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
}

.keys-available .key-count { color: var(--success); text-shadow: 0 0 5px var(--success); }
.keys-low .key-count { color: var(--warning); }
.keys-none .key-count { color: var(--error); }

/* --- VARIANT SPECIFIC --- */
.warning-notice {
    position: relative;
    max-width: 800px;
    background: rgba(252, 255, 51, 0.08);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(252, 255, 51, 0.4);
    border-left: 8px solid rgba(252, 255, 51,);
    border-radius: 4px;
    padding: 1.5rem;
    margin-bottom: 2.5rem;
    animation: warningSlideIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 0 20px rgba(255, 51, 102, 0.1), inset 0 0 30px rgba(252, 255, 51, 0.02);
}

.warning-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1rem;
}

.warning-icon {
    font-size: 1.3rem;
    color: rgb(192, 196, 0);;
    filter: drop-shadow(0 0 5px rgb(242, 246, 2));   
    animation: warningPulse 2s ease-in-out infinite;
}

.warning-label {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.85rem;
    color: rgb(178, 181, 0);;
    letter-spacing: 1px;
    font-weight: 700;
    text-transform: uppercase;
}

.warning-text {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    line-height: 1.6;
    font-family: 'Rajdhani', sans-serif;
    margin: 0;
}

@keyframes warningSlideIn {
    0% {
        opacity: 0;
        transform: translateX(-20px);
        filter: blur(5px);
    }
    100% {
        opacity: 1;
        transform: translateX(0);
        filter: blur(0);
    }
}

@keyframes warningPulse {
    0%, 100% {
        filter: drop-shadow(0 0 5px var(--error));
    }
    50% {
        filter: drop-shadow(0 0 12px var(--error));
    }
}

/* --- VARIANT SPECIFIC --- */
.variant-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 1rem;
}

.variant-icon {
    font-size: 2.5rem;
    color: var(--neon-violet);
    margin-bottom: 10px;
}

.variant-price {
    font-family: 'Orbitron', sans-serif;
    font-size: 2rem;
    color: var(--neon-cyan);
    margin-bottom: 1.5rem;
    text-shadow: 0 0 15px rgba(0, 243, 255, 0.4);
}

.variant-features {
    list-style: none;
    text-align: left;
    margin-bottom: 2rem;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 1.5rem;
}

.variant-features li {
    margin-bottom: 0.8rem;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #ccc;
    font-size: 0.95rem;
}

.variant-features li i {
    color: var(--neon-cyan);
    font-size: 0.8rem;
}

.premium-badge {
    position: absolute;
    top: 0; right: 0;
    background: var(--neon-violet);
    color: #fff;
    font-size: 0.7rem;
    padding: 5px 10px;
    font-weight: 700;
    border-bottom-left-radius: 10px;
}

/* --- DETAILS SCREEN --- */
.details-content {
    width: 100%;
    max-width: 1000px;
    text-align: center;
}

.details-title {
    font-size: 3.5rem;
    color: var(--neon-cyan);
    text-shadow: 0 0 20px rgba(0, 243, 255, 0.5);
}

.section-container {
    margin: 4rem 0;
}

.section-header {
    font-size: 1.5rem;
    color: var(--neon-violet);
    border-bottom: 1px solid rgba(188, 19, 254, 0.3);
    padding-bottom: 10px;
    margin-bottom: 2rem;
    text-align: left;
    display: flex;
    align-items: center;
}

.section-header span {
    background: rgba(188, 19, 254, 0.1);
    padding: 5px 15px;
    clip-path: polygon(0 0, 100% 0, 95% 100%, 0% 100%);
}

.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
}

.feature-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
    padding: 1.5rem;
    text-align: left;
    transition: 0.3s;
}

.feature-card:hover {
    background: rgba(0, 243, 255, 0.05);
    border-color: var(--neon-cyan);
}

.feature-icon { font-size: 2rem; margin-bottom: 1rem; }
.feature-title { color: var(--neon-cyan); font-family: 'Orbitron'; margin-bottom: 0.5rem; }
.feature-description { font-size: 0.9rem; color: #aaa; }

.video-container {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    border: 1px solid var(--neon-cyan);
    box-shadow: 0 0 20px rgba(0, 243, 255, 0.2);
}

.video-container iframe {
    position: absolute; top:0; left: 0; width: 100%; height: 100%;
}

/* --- DOWNLOAD & WHATSAPP --- */
.download-icon-pulse {
    font-size: 5rem;
    color: var(--neon-cyan);
    margin-bottom: 2rem;
    animation: pulseGlow 2s infinite;
}

.status-text {
    font-size: 1.2rem;
    margin-bottom: 3rem;
    color: #aaa;
}

.progress-wrapper {
    width: 100%;
    max-width: 500px;
    margin: 2rem auto;
}

.progress-bar-bg {
    width: 100%;
    height: 6px;
    background: rgba(255,255,255,0.1);
    border-radius: 3px;
    overflow: hidden;
}

.progress-bar-fill {
    width: 0%;
    height: 100%;
    background: var(--neon-cyan);
    box-shadow: 0 0 10px var(--neon-cyan);
    transition: width 0.2s linear;
}

.progress-text {
    margin-top: 10px;
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    color: var(--neon-cyan);
    letter-spacing: 2px;
}

.file-meta {
    margin-top: 2rem;
    font-family: 'Rajdhani', sans-serif;
    color: #666;
}

.highlight { color: #fff; font-weight: 700; }

.whatsapp-card {
    border-color: var(--success);
    background: linear-gradient(180deg, rgba(0,255,157,0.05) 0%, rgba(0,0,0,0) 100%);
    max-width: 500px;
    margin: 0 auto;
}

.wa-icon-glow {
    font-size: 4rem;
    color: var(--success);
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 0 10px var(--success));
}

.wa-btn {
    border-color: var(--success);
    color: var(--success);
    width: 100%;
    margin-top: 2rem;
}

.wa-btn:hover {
    background: rgba(0, 255, 157, 0.1);
    box-shadow: 0 0 20px var(--success);
}

/* --- UTILITIES --- */
.back-btn {
    position: absolute;
    top: 100px; left: 20px;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.5);
    font-family: 'Orbitron';
    cursor: pointer;
    transition: 0.3s;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 100;
}

.back-btn:hover { color: var(--neon-cyan); padding-left: 5px; }

/* Notification */
.notification-panel {
    position: fixed;
    bottom: 30px; right: 30px;
    background: rgba(5, 5, 16, 0.95);
    border-left: 4px solid var(--neon-cyan);
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 15px;
    transform: translateX(200%);
    transition: 0.5s cubic-bezier(0.68, -0.55, 0.27, 1.55);
    z-index: 2000;
    box-shadow: 0 10px 30px rgba(0,0,0,0.8);
    backdrop-filter: blur(10px);
    width: 350px;
}

.notification-panel.show { transform: translateX(0); }

.notification-panel.success { border-color: var(--success); }
.notification-panel.success .notif-title { color: var(--success); }

.notification-panel.error { border-color: var(--error); }
.notification-panel.error .notif-title { color: var(--error); }

.notif-title {
    font-family: 'Orbitron';
    font-size: 0.8rem;
    color: var(--neon-cyan);
    margin-bottom: 5px;
}

.notification-message { font-size: 0.9rem; color: #ddd; }

/* --- LOADING SCREEN --- */
.loading-screen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #050510;
    background-image: radial-gradient(circle at 50% 50%, #0d1221 0%, #000 100%);
    z-index: 10000;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 1;
    transition: opacity 1s ease-out;
}

.loading-screen.fade-out {
    opacity: 0;
    pointer-events: none;
}

.loading-container {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 500px;
}

/* Hologram Loader */
.hologram-loader {
    position: relative;
    width: 250px;
    height: 250px;
    margin-bottom: 3rem;
    perspective: 1000px;
}

.loader-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    border: 3px solid transparent;
    border-top: 3px solid var(--neon-cyan);
    border-right: 3px solid var(--neon-violet);
    border-radius: 50%;
    animation: spinLoader 3s linear forwards;
    box-shadow: 0 0 30px rgba(0, 243, 255, 0.4), inset 0 0 30px rgba(188, 19, 254, 0.2);
    top: 0;
    left: 0;
}

.loader-core {
    position: absolute;
    width: 60%;
    height: 60%;
    top: 20%;
    left: 20%;
    border: 2px solid transparent;
    border-bottom: 2px solid var(--neon-cyan);
    border-left: 2px solid var(--neon-violet);
    border-radius: 50%;
    animation: spinLoaderReverse 2s linear forwards;
    box-shadow: 0 0 20px rgba(0, 243, 255, 0.3);
}

.core-dot {
    position: absolute;
    width: 15px;
    height: 15px;
    background: radial-gradient(circle, var(--neon-cyan) 0%, rgba(0, 243, 255, 0) 70%);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 20px var(--neon-cyan), 0 0 40px rgba(0, 243, 255, 0.5);
    animation: pulseCore 1s ease-in-out infinite;
}

@keyframes spinLoader {
    0% {
        transform: rotateZ(0deg) rotateX(0deg);
        opacity: 0;
    }
    10% {
        opacity: 1;
    }
    100% {
        transform: rotateZ(360deg) rotateX(180deg);
        opacity: 1;
    }
}

@keyframes spinLoaderReverse {
    0% {
        transform: rotateZ(0deg);
        opacity: 0;
    }
    10% {
        opacity: 1;
    }
    100% {
        transform: rotateZ(-360deg);
        opacity: 1;
    }
}

@keyframes pulseCore {
    0%, 100% {
        transform: translate(-50%, -50%) scale(1);
        box-shadow: 0 0 20px var(--neon-cyan), 0 0 40px rgba(0, 243, 255, 0.5);
    }
    50% {
        transform: translate(-50%, -50%) scale(1.4);
        box-shadow: 0 0 30px var(--neon-cyan), 0 0 60px rgba(0, 243, 255, 0.8);
    }
}

/* Loading Text */
.loading-text {
    text-align: center;
    color: #fff;
    font-family: 'Orbitron', sans-serif;
}

.boot-text {
    font-size: 1.8rem;
    font-weight: 900;
    letter-spacing: 4px;
    color: var(--neon-cyan);
    text-shadow: 0 0 20px rgba(0, 243, 255, 0.5);
    margin-bottom: 0.5rem;
    animation: glitchText 0.3s infinite;
}

.boot-subtext {
    font-size: 0.9rem;
    letter-spacing: 3px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 2rem;
    font-family: 'Rajdhani', sans-serif;
    animation: flickerText 2s infinite;
}

@keyframes glitchText {
    0%, 100% { text-shadow: 0 0 20px rgba(0, 243, 255, 0.5); }
    50% { text-shadow: 0 0 30px rgba(188, 19, 254, 0.5); }
}

@keyframes flickerText {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
}

/* Loading Bar */
.loading-bar {
    width: 250px;
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(0, 243, 255, 0.3);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 1rem;
    box-shadow: 0 0 10px rgba(0, 243, 255, 0.2);
}

.bar-fill {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, var(--neon-cyan), var(--neon-violet), var(--neon-cyan));
    box-shadow: 0 0 15px var(--neon-cyan);
    animation: fillBar 3s ease-in-out forwards;
}

@keyframes fillBar {
    0% { width: 0%; }
    50% { width: 60%; }
    100% { width: 100%; }
}

.load-percentage {
    font-size: 0.85rem;
    color: var(--neon-cyan);
    letter-spacing: 2px;
    font-family: 'Courier New', monospace;
    font-weight: 700;
}

/* Scanline Effect */
.scanline-effect {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.1) 50%, rgba(0,0,0,0.1));
    background-size: 100% 4px;
    pointer-events: none;
    z-index: 1001;
}

/* --- RESPONSIVE --- */
@media (max-width: 768px) {
    .hologram-loader {
        width: 180px;
        height: 180px;
        margin-bottom: 2rem;
    }
    
    .boot-text {
        font-size: 1.4rem;
    }
    
    .loading-bar {
        width: 200px;
    }
}

/* --- RESPONSIVE --- */
@media (max-width: 768px) {
    .navbar-menu {
        position: fixed;
        top: 70px; left: 0;
        width: 100%;
        background: rgba(5,5,10,0.98);
        flex-direction: column;
        padding: 2rem;
        transform: translateY(-150%);
        transition: 0.4s;
        gap: 2rem;
    }
    
    .navbar-menu.active { transform: translateY(0); }
    .navbar-toggle { display: flex; }
    
    .logo { font-size: 2.5rem; }
    .screen-title { font-size: 1.8rem; }
    
    .holo-ring-container { width: 220px; height: 220px; }
    
    .back-btn { top: 85px; font-size: 0.8rem; }
    
    .version-cards, .variant-cards { flex-direction: column; align-items: center; }
    .tilt-card { width: 100%; max-width: 350px; }
}